{
  "name": "theory-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A living map of socialist thought — ideas, thinkers, texts, tendencies, debates and their relationships.",
  "scripts": {
    "dev": "cross-env ATLAS_DEMO_USERS=1 npm run db:ensure && next dev",
    "build": "npm run db:ensure && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:ensure": "tsx scripts/db.ts ensure",
    "db:reindex": "tsx scripts/db.ts reindex",
    "test:e2e": "playwright test",
    "user:create": "tsx scripts/users.ts create",
    "user:list": "tsx scripts/users.ts list",
    "corpus": "tsx --conditions=react-server scripts/corpus.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
