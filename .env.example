# Database. Defaults to a local SQLite file. Point at a libSQL/Turso URL in production.
DATABASE_URL=file:data/atlas.db
# DATABASE_AUTH_TOKEN=

# Where uploaded images are stored (default: data/uploads). Use a persistent volume in production.
# MEDIA_DIR=data/uploads

# Editorial desk accounts are created with `npm run user:create` — there are no default credentials.
# `npm run dev` sets ATLAS_DEMO_USERS=1 to create four demo accounts locally; this is refused in production.
# ATLAS_DEMO_USERS=1
